' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml c4-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()

title Ghostwriter MCP Server - Component Diagram

Person_Ext(mcpClient, "MCP Client", "AI assistant, IDE, or automation process that invokes MCP tools over STDIO or HTTP.")

System_Boundary(gwMcpServer, "Ghostwriter MCP Server") {
    Component(mcpRuntime, "MCP Server Runtime and CLI", "Java / MCP", "McpServer entry point that loads runtime configuration, registers tools, and exposes them over STDIO or HTTP.")
    Component(runtimeConfiguration, "Runtime Configuration", "Java properties", "Loads the MCP configuration file and supplies server, project, transport, and generative-AI settings to the runtime and tools.")
    Component(ghostwriterTools, "Ghostwriter Tools", "Java library", "Provides project-aware file, command, web, context, guidance, and AI-assisted workflow operations.")
    Component(bindexServices, "Bindex Core Services", "Java library", "Retrieves, validates, and registers Bindex metadata and provides semantic library recommendations.")
}

System_Ext(genAiProvider, "Configured Generative AI Provider", "External provider such as CodeMie selected by gw.model and genai.serverId configuration.")
System_Ext(packageRepos, "Maven / Library Metadata Sources", "External repositories and indexes used for dependency metadata and library recommendations.")
System_Ext(bindexRegistry, "Bindex Registry", "External Bindex service that stores and serves registered metadata descriptors.")

Rel(mcpClient, mcpRuntime, "Invokes MCP tools", "STDIO / HTTP")
Rel(mcpRuntime, runtimeConfiguration, "Loads server and tool configuration", "Properties API")
Rel(mcpRuntime, ghostwriterTools, "Registers and executes project assistance tools", "Java API")
Rel(mcpRuntime, bindexServices, "Exposes metadata and recommendation tools", "Java API")
Rel(runtimeConfiguration, ghostwriterTools, "Supplies provider and workflow settings", "Configuration API")
Rel(runtimeConfiguration, bindexServices, "Supplies service settings", "Configuration API")
Rel(ghostwriterTools, genAiProvider, "Requests code generation and analysis", "Provider API")
Rel(bindexServices, packageRepos, "Looks up dependency metadata and recommendations", "Repository/index APIs")
Rel(bindexServices, bindexRegistry, "Retrieves and registers Bindex descriptors", "Bindex API")
Rel(ghostwriterTools, bindexServices, "Uses metadata to enrich recommendations", "Java API")

SHOW_LEGEND()
@enduml
