' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml c4-diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Ghostwriter MCP Server - Component Diagram

Person_Ext(mcpClient, "MCP Client", "AI assistant, IDE, or automation process that invokes MCP tools.")

Container_Boundary(gwMcpServer, "Ghostwriter MCP Server", "Java 17 executable JAR") {
  Component(mcpRuntime, "Machai MCP Server Runtime", "machai-mcp-server dependency", "Provides the MCP server entry point and exposes registered tools over STDIO or HTTP.")
  Component(ghostwriterTools, "Ghostwriter Tools", "ghostwriter dependency", "Provides project-aware workflows, file and command operations, guidance processing, and model-assisted capabilities.")
  Component(bindexCore, "Bindex Core Tools", "bindex-core dependency", "Provides Bindex metadata retrieval and registration, schema access, and library recommendations.")
}

System_Ext(genAiProvider, "Configured Generative AI Provider", "Provider used by model-assisted Ghostwriter workflows, such as CodeMie.")
System_Ext(packageRepos, "Maven / Library Metadata Sources", "External repositories and indexes used for dependency metadata and library recommendations.")
System_Ext(bindexRegistry, "Bindex Registry", "External Bindex service that stores and serves registered metadata descriptors.")

Rel(mcpClient, mcpRuntime, "Invokes MCP tools and resources", "STDIO / HTTP")
Rel(mcpRuntime, ghostwriterTools, "Dispatches tool requests to")
Rel(mcpRuntime, bindexCore, "Dispatches tool requests to")
Rel(ghostwriterTools, genAiProvider, "Requests model-assisted processing", "Provider API")
Rel(bindexCore, packageRepos, "Looks up dependency metadata and recommendations", "Repository/index APIs")
Rel(bindexCore, bindexRegistry, "Retrieves and registers Bindex descriptors", "Bindex API")

note bottom of gwMcpServer
  Component boundaries reflect the project's declared Maven dependencies;
  this module has no local Java source components in src/main/java.
  Entry point: org.machanism.machai.mcp.server.McpServer
  Configuration: mcp-server.properties; optional gw.properties.
end note

SHOW_LEGEND()
@enduml
